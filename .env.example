# Phaarvai - environment configuration
# Copy to .env.local for local development.
# Add the same keys in Vercel → Project → Settings → Environment Variables.

# --- Partnership form (POST /api/partnership) — Resend ---
# Resend account: priya.bakkiyaraj@phaarvai.com
PARTNERSHIP_TO_EMAIL=partnerships@gmail.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Phaarvai <noreply@phaarvai.com>
# Used until phaarvai.com is verified in Resend
RESEND_DEV_FROM_EMAIL=Phaarvai <onboarding@resend.dev>
RESEND_ACCOUNT_EMAIL=priya.bakkiyaraj@phaarvai.com

# General contact form inbox (contact API only)
CONTACT_TO_EMAIL=partnerships@phaarvai.com

# Optional contact-form email providers (not used by partnership API)
CONTACT_EMAIL_PROVIDER=resend
CONTACT_FROM_EMAIL=Phaarvai <noreply@phaarvai.com>
CONTACT_FORMSUBMIT=true
POSTMARK_SERVER_TOKEN=

CONTACT_PERSIST=true
CONTACT_DATA_DIR=.data
CONTACT_WEBHOOK_URL=
